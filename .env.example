# Copy to .env and set the SSH connection used by `pnpm dev:remote`.
SSH_HOST=192.0.2.1
SSH_PORT=22
SSH_USERNAME=root
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
# SSH_PASSPHRASE=

# One local directory per corresponding remote directory, comma-separated.
LOCAL_DIST_PATH=htdocs/luci-static/resources/view/fttr,root/usr/share/luci/menu.d,root/usr/share/rpcd/acl.d,root/usr/libexec/rpcd
SSH_REMOTE_PATH=/www/luci-static/resources/view/fttr,/usr/share/luci/menu.d,/usr/share/rpcd/acl.d,/usr/libexec/rpcd
BUILD_COMMAND=pnpm run build:watch
