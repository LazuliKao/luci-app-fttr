# Copy to .env and set the SSH connection used by `pnpm dev:remote`.
SSH_HOST=192.0.2.1
SSH_PORT=22
SSH_USERNAME=root
SSH_PRIVATE_KEY_PATH=~/.ssh/id_ed25519
# SSH_PASSPHRASE=

# One local directory per corresponding remote directory, comma-separated.
LOCAL_DIST_PATH=package/luci-app-fttr/htdocs/luci-static/resources/view/fttr,package/luci-app-fttr/root/usr/share/luci/menu.d,package/luci-app-fttr/root/usr/share/rpcd/acl.d,package/luci-app-fttr/root/usr/libexec,package/luci-app-fttr/root/usr/share/fttr
SSH_REMOTE_PATH=/www/luci-static/resources/view/fttr,/usr/share/luci/menu.d,/usr/share/rpcd/acl.d,/usr/libexec,/usr/share/fttr
BUILD_COMMAND=pnpm run build:watch

# ============================================================
# Translation (luci-types i18n) Configuration
# ============================================================
# Required for `pnpm run i18n:build` (AI-powered translation)
# Uses @dotenvx/dotenvx to load .env automatically.
# ============================================================
OPENAI_API_KEY=

# Optional: Override the API base URL for custom/local providers (e.g. DeepSeek, Qwen, OpenAI-compatible proxy)
# Default: https://api.openai.com/v1/chat/completions
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Optional: Override the model used (Default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
