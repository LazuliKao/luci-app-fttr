{
	"luci-app-fttr": {
		"description": "Read FTTR synchronization status and manage FTTR provisioning",
		"read": {
			"uci": [ "fttr" ],
			"ubus": {
				"luci.fttr": [ "get_status", "get_sync", "config_check" ],
				"luci-rpc": [ "getNetworkDevices" ]
			}
		},
		"write": {
			"uci": [ "fttr" ],
			"ubus": {
				"luci.fttr": [ "config_reload", "sync", "restart_service" ]
			}
		}
	}
}
