{
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**/*",
			"!package/luci-app-fttr/htdocs/**/*",
			"!node_modules/**/*",
			"!src/api/generated/**/*",
			"!package/luci-app-fttr/root/usr/share/rpcd/acl.d/luci-app-fttr.json"
		]
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
