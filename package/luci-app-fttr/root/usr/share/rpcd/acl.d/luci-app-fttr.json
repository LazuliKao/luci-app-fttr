{
	"luci-app-fttr": {
		"description": "Read FTTR synchronization status and manage FTTR provisioning",
		"read": {
			"uci": ["fttr"],
			"ubus": {
				"fttr": ["get_capabilities", "get_status", "get_sync", "config_check", "optical_status", "npu_status"],
				"luci.fttr": [
					"mib_start",
					"mib_result",
					"mib_release",
					"hl202_list",
					"hl202_report",
					"hl202_job_result",
					"get_calibration"
				],
				"luci-rpc": ["getNetworkDevices"]
			}
		},
		"write": {
			"uci": ["fttr"],
			"ubus": {
				"fttr": ["config_reload", "sync", "restart_service", "optical_set"],
				"luci.fttr": [
					"config_reload",
					"sync",
					"restart_service",
					"hl202_exec_start",
					"hl202_accounts_start",
					"hl202_account_update",
					"save_calibration",
					"apply_calibration",
					"npu_set"
				]
			}
		}
	}
}
