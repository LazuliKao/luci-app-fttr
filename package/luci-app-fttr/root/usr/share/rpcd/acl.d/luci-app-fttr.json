{
	"luci-app-fttr": {
		"description": "Read and manage FTTR devices through the native controller",
		"read": {
			"uci": ["fttr"],
			"ubus": {
				"fttr": [
					"get_capabilities",
					"get_status",
					"get_sync",
					"config_check",
					"optical_status",
					"npu_status",
					"mib_start",
					"mib_result",
					"job_result",
					"job_release",
					"hl202_list",
					"hl202_report",
					"hl202_accounts_start",
					"get_calibration"
				],
				"luci-rpc": ["getNetworkDevices"]
			}
		},
		"write": {
			"uci": ["fttr"],
			"ubus": {
				"fttr": [
					"config_reload",
					"sync",
					"restart_service",
					"optical_set",
					"npu_set",
					"hl202_exec_start",
					"hl202_account_update",
					"save_calibration",
					"apply_calibration"
				]
			}
		}
	}
}
