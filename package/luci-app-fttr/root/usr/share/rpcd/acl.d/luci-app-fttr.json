{
	"luci-app-fttr": {
		"description": "Read FTTR synchronization status and manage FTTR provisioning",
		"read": {
			"uci": ["fttr"],
			"ubus": {
				"luci.fttr": [
					"get_capabilities",
					"get_status",
					"get_sync",
					"config_check",
					"mib_start",
					"mib_result",
					"mib_release",
					"hl202_list",
					"hl202_report",
					"hl202_job_result",
					"get_calibration",
					"optical_status"
				],
				"luci-rpc": ["getNetworkDevices"]
			}
		},
		"write": {
			"uci": ["fttr"],
			"ubus": {
				"luci.fttr": [
					"config_reload",
					"sync",
					"restart_service",
					"hl202_exec_start",
					"hl202_accounts_start",
					"hl202_account_update",
					"save_calibration",
					"apply_calibration",
					"optical_set"
				]
			}
		}
	}
}
